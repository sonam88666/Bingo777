rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows any authenticated user (including anonymous sessions initialized on startup)
    // to participate in real-time gaming, live bets, ledger sync, and administrative controls.
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
      match /private/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    match /transactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /deposits/{depositId} {
      allow read, write: if isSignedIn();
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if isSignedIn();
    }

    match /live_bets/{betId} {
      allow read, write: if isSignedIn();
    }

    match /wingo_rounds/{roundId} {
      allow read, write: if isSignedIn();
    }

    match /admin_settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /gift_codes/{codeId} {
      allow read, write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /aviator_rounds/{roundId} {
      allow read, write: if isSignedIn();
    }

    match /support_messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
